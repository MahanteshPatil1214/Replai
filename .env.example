# Copy this file to .env and fill in the values.
# NEVER commit the real .env file.

# LLM - any OpenAI-compatible endpoint works (OpenAI, OpenRouter, Groq, Ollama, vLLM).
# Leave LLM_API_KEY empty to run with the built-in fallback classifier.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Infra (defaults match docker-compose.yml)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
POSTGRES_URL=jdbc:postgresql://postgres:5432/replai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=replai
POSTGRES_USER=replai
POSTGRES_PASSWORD=replai

# Local (outside Docker) equivalents: kafka -> localhost:9092, postgres -> localhost:5433
